# SUPERSET CORE ENV. VARIABLES

# Allowing python to print() in docker
PYTHONUNBUFFERED=1
# Allowing development environment mode
DEV_MODE=true
# Superset Admin credentials
ADMIN_USER=mca-adm29
ADMIN_EMAIL=mca.admin@superset.com
ADMIN_FIRSTNAME=Mattheo
ADMIN_LASTNAME=Polnareff
# Superset metadata postgres database configurations
SUPERSET_DATABASE_DB=superset
SUPERSET_DATABASE_HOST=superset-metadata-db
DATABASE_USER=superset
# Cypress example DB credentials
EXAMPLES_DB=examples
EXAMPLES_HOST=superset-metadata-db
EXAMPLES_USER=examples
# Make sure you set this to a unique secure random value on production
EXAMPLES_PASSWORD=examples
EXAMPLES_PORT=5432
# database engine specific environment variables
# change the below if you prefer another database engine
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql

# Add the mapped in /app/pythonpath_docker which allows devs to override stuff
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=superset-cache-database
REDIS_PORT=6379

FLASK_DEBUG=true
SUPERSET_ENV=development
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

# Make sure you set this to a unique secure random value on production
SUPERSET_SECRET_KEY=TEST_NON_DEV_SECRET

ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true
SUPERSET_LOG_LEVEL=info